# Claude Code local settings
.claude/settings.local.json

# /document-vortex scan output. Regenerated by the skill's inventory.py on every run and read only
# by gen-indexes.py; 360 KB of symbol paths that churn on any rename. The documentation it feeds is
# committed, the scan behind it is not.
.claude/document-vortex-inventory.json

