<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The control page is a single hand-written file, not a bundled app: there is deliberately no
         npm step here, because the one moment this UI matters is when everything else is down. -->
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Logging\Vortex.Logging.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The content root is pinned to the assembly's own directory (see Program.cs) so config
         resolution does not depend on where the process was launched from. That also moves the web
         root to bin/wwwroot, which the SDK does not populate on build - without this the control
         page 404s from the built output while working fine from the project directory.
         Update rather than Include: the web SDK already picks wwwroot up as Content, it simply does
         not copy it. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shares the emulator's appsettings.json so the supervisor reads the same
         Vortex:Supervisor section the operator already edits. -->
    <Content Include="../appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../appsettings.Development.json"
      Condition="Exists('../appsettings.Development.json')"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../appsettings.Production.json"
      Condition="Exists('../appsettings.Production.json')"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
