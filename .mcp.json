{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql@2.0.9"],
      "env": {
        "MYSQL_HOST": "${VORTEX_MYSQL_HOST:-127.0.0.1}",
        "MYSQL_PORT": "${VORTEX_MYSQL_PORT:-3306}",
        "MYSQL_USER": "${VORTEX_MYSQL_USER:-root}",
        "MYSQL_PASS": "${VORTEX_MYSQL_PASS:-admin}",
        "MYSQL_DB": "${VORTEX_MYSQL_DB:-turbo}",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    }
  }
}
