<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by DashboardAuthorizationMatrixTests and read back by it. Never hand-edited. -->
    <None
      Include="Hosting/authorization-matrix.txt"
      Link="authorization-matrix.txt"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Dashboard.API\Vortex.Dashboard.API.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <!--
      The real signal vocabulary. The editor's rules decide which filters an operator may write, and
      checking them against a hand-written vocabulary would only prove the test agrees with itself —
      SignalVocabularyFixture builds it from the translators that are actually loaded.
    -->
    <ProjectReference Include="..\Vortex.Signals\Vortex.Signals.csproj" />
  </ItemGroup>
</Project>
