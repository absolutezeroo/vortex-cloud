<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Habbicons and reward tracks. Their own test project rather than a folder in an existing one
      because the two assemblies under test are new and neither belongs to Rooms, Players or
      Progression.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Habbicons\Vortex.Habbicons.csproj" />
    <ProjectReference Include="..\Vortex.RewardTracks\Vortex.RewardTracks.csproj" />
    <!-- The sequence tests validate against the vocabulary the real translators declare. -->
    <ProjectReference Include="..\Vortex.Signals\Vortex.Signals.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <!--
      The content validator lives with the dashboard, because authoring content is the
      dashboard's job. Its tests stay here because they are built on Content, this project's
      reward-track builder, which reaches domain types the dashboard has no business knowing.
    -->
    <ProjectReference Include="..\Vortex.Dashboard.API\Vortex.Dashboard.API.csproj" />
  </ItemGroup>
</Project>
