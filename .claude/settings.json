{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/post-edit.mjs"],
            "statusMessage": "Verification dashboard/front-end",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/guard-emulator.mjs"],
            "statusMessage": "Garde emulateur",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
