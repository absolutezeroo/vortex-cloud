<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Habbicons: the definitions, the collections, who owns what, and the four ways ownership
      changes (bought singly, bought as a set, claimed as a set's bonus, granted by something
      else). Its own assembly rather than a folder in Vortex.Progression because a Habbicon is a
      collectible, not a measure of progress: an achievement counts what you did, a Habbicon is
      a thing you have and can use in a room.

      Reward tracks depend on this one, never the other way round: a track can hand out a
      Habbicon, and nothing here has heard of a track.
    -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Rewards.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Database\Vortex.Database.csproj" />
    <ProjectReference Include="..\Vortex.Events\Vortex.Events.csproj" />
    <ProjectReference Include="..\Vortex.Logging\Vortex.Logging.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <ProjectReference Include="..\Vortex.Protocol\Vortex.Protocol.csproj" />
  </ItemGroup>
</Project>
