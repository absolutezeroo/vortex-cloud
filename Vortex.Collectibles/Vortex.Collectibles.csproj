<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Collections, minting, the store, claims, the vault and the NFT wardrobe. Lifted out of
      Vortex.Players, which had grown into a bucket holding identity next to nine unrelated
      feature areas. Nothing outside ever named these grain classes: every caller goes through
      the interfaces in Vortex.Primitives, which is what made the move a lift rather than a
      refactor.

      Notably protocol-free: these grains speak snapshots only, so a composer edit does not
      rebuild them.
    -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Players.Tests" />
    <InternalsVisibleTo Include="Vortex.Rooms.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Database\Vortex.Database.csproj" />
    <ProjectReference Include="..\Vortex.Logging\Vortex.Logging.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
  </ItemGroup>
</Project>
