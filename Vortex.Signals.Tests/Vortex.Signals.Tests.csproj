<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      The tests that could not be written before.

      Every translation used to live inside an Orleans handler needing an IGrainFactory, so driving
      one meant standing up half a silo — and the test that was supposed to keep the fact vocabulary
      in step with the handlers was therefore never written, and the two drifted on nine actions
      without anything noticing. A translator is a pure function, so these run in milliseconds.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <ProjectReference Include="..\Vortex.Signals\Vortex.Signals.csproj" />
    <!-- The consumers' mapping tables, checked against the translators in the same suite. -->
    <ProjectReference Include="..\Vortex.Progression\Vortex.Progression.csproj" />
  </ItemGroup>
</Project>
