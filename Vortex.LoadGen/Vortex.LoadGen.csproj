<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!--
      Deliberately depends on nothing. This process exists to stop the emulator from measuring
      itself, and a reference to any of its projects would drag the very allocations and background
      services the separation is meant to keep out.
    -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Rooms.Tests" />
  </ItemGroup>
</Project>
