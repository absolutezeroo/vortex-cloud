<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      The reward-track engine: a generic campaign progression system. Tracks, tasks with stages,
      track points, milestones, a premium tier, and a reward pipeline that hands over anything the
      hotel can grant.

      Nothing in here knows what the Introduction Track is. That track is a row in reward_tracks
      with rows in reward_track_tasks beside it, and so is every campaign after it: adding one is
      content, never code. The only reason to write C# for a campaign is a progression rule the
      four task modes cannot express, and there is no such campaign yet.

      Depends on Vortex.Habbicons because a prize may be a Habbicon. The dependency runs one way
      only.
    -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Rewards.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vortex.Database\Vortex.Database.csproj" />
    <ProjectReference Include="..\Vortex.Events\Vortex.Events.csproj" />
    <ProjectReference Include="..\Vortex.Logging\Vortex.Logging.csproj" />
    <ProjectReference Include="..\Vortex.Primitives\Vortex.Primitives.csproj" />
    <ProjectReference Include="..\Vortex.Protocol\Vortex.Protocol.csproj" />
  </ItemGroup>
</Project>
